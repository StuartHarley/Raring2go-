{
  "name": "raring2go",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.18.0 <27",
    "pnpm": "11.16.0"
  },
  "scripts": {
    "build": "turbo run build",
    "db:generate": "pnpm --filter @raring2go/db db:generate",
    "db:migrate": "pnpm --filter @raring2go/db db:migrate",
    "db:seed": "pnpm --filter @raring2go/db db:seed",
    "db:seed:uat": "pnpm --filter @raring2go/db db:seed:uat",
    "dev": "turbo run dev --filter=@raring2go/web",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "uat:check": "pnpm --filter @raring2go/db uat:check",
    "uat:db:setup": "pnpm --filter @raring2go/db uat:db:setup",
    "uat:smoke": "pnpm --filter @raring2go/db uat:smoke"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "turbo": "2.10.9",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
