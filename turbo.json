{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_DIRECT_URL",
    "DATABASE_MIGRATION_URL",
    "DATABASE_URL",
    "RUN_DB_TESTS"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    }
  }
}
