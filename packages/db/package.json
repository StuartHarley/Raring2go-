{
  "name": "@raring2go/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:seed:uat": "tsx src/seed-uat.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "uat:check": "tsx src/uat-toolkit.ts check",
    "uat:db:setup": "tsx src/uat-toolkit.ts db:setup",
    "uat:scan": "tsx src/uat-toolkit.ts scan",
    "uat:smoke": "tsx src/uat-toolkit.ts smoke",
    "uat:storage": "tsx src/uat-toolkit.ts storage"
  },
  "dependencies": {
    "@raring2go/storage": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12"
  }
}
