APP_ENV=development
NEXT_PUBLIC_APP_NAME=Raring2go Business-in-a-Box
DATABASE_URL=postgres://raring2go:raring2go@localhost:5432/raring2go

# PIL-004 email transport. Use "console" locally, or configure "http"/"smtp".
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@raring2go.local
# EMAIL_HTTP_ENDPOINT=
# EMAIL_HTTP_API_KEY=
# EMAIL_HTTP_PROVIDER_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# PIL-005 storage. Development is local deterministic; signed-url is deployment/provider-backed.
STORAGE_PROVIDER=development
# STORAGE_BASE_URL=
# STORAGE_SIGNING_SECRET=
# STORAGE_PROVIDER_KEY=
# STORAGE_URL_TTL_SECONDS=900

# UAT-001A provider connection secret encryption. Use a base64 encoded 32-byte key.
# Never commit real production values.
# INTEGRATION_SECRET_ENCRYPTION_KEY=
INTEGRATION_SECRET_KEY_VERSION=v1

# UAT-001B Meta OAuth connection. Do not commit real app secrets.
# META_APP_ID=
# META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/meta/callback
# META_OAUTH_SCOPES=pages_manage_posts,pages_read_engagement
# META_GRAPH_API_VERSION=v20.0

# PIL-006 social provider. Development uses deterministic publishing.
SOCIAL_PROVIDER=development
# Emergency/development compatibility only. Production connected Page publishing
# should resolve scoped credentials through provider_connections + SecretStore.
# META_FACEBOOK_PAGE_ID=
# META_FACEBOOK_PAGE_ACCESS_TOKEN=
